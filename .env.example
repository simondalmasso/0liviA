# Runtime state must live OUTSIDE the Git checkout.
OLIVIA_DATA_DIR=/var/lib/0livia
OLIVIA_BIND=127.0.0.1
OLIVIA_PORT=8080

# Owner browser auth. Generate only the internal signing token here.
# First run uses the browser "Registrate" flow and stores a scrypt verifier in SQLite.
OLIVIA_GATEWAY_TOKEN=REPLACE_ME
# Optional first-registration protection for internet-exposed bootstrap:
# OLIVIA_REGISTRATION_TOKEN=
# Legacy/migration-only owner seed (normally leave unset):
# OLIVIA_OWNER_EMAIL=
# OLIVIA_OWNER_PASSWORD_VERIFIER=

OLIVIA_TTFT_TIMEOUT_S=12
OLIVIA_CIRCUIT_BASE_S=15
OLIVIA_CIRCUIT_MAX_S=600
OLIVIA_MAX_HISTORY=24
# Total outbound system+memory+web+history budget. Recent/current turns win.
OLIVIA_MAX_CONTEXT_CHARS=48000

# Provider registry. Secrets are referenced by ENV NAME, never embedded here.
# Example:
# OLIVIA_PROVIDERS_JSON=[{"name":"groq","base_url":"https://api.groq.com/openai/v1","model":"YOUR_MODEL","api_key_env":"GROQ_API_KEY","priority":10,"daily_limit":0}]
# Hard default: never use a route that can create a charge.
OLIVIA_HARD_ZERO_COST=1
# cost_mode values:
#   local           -> no metered external inference
#   free_hard_cap   -> upstream route/account cannot bill beyond free allowance
#   plan_included   -> eligible subscription usage; requires explicit no-credit-overage verification
#   free_unverified -> advertised free quota, billing boundary not proven (blocked)
#   paid            -> blocked
# Example:
# OLIVIA_PROVIDERS_JSON=[{"name":"free-lane","base_url":"https://example/v1","model":"m","api_key_env":"FREE_API_KEY","priority":10,"daily_limit":100,"cost_mode":"free_hard_cap"}]
OLIVIA_PROVIDERS_JSON=[]

# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=


# Router reliability
OLIVIA_CIRCUIT_HALF_OPEN_PROBES=1
OLIVIA_CIRCUIT_JITTER=0.2
OLIVIA_PROBE_LEASE_S=90
OLIVIA_MAX_PROVIDER_ATTEMPTS=3
OLIVIA_COOLDOWN_RATE_LIMIT_S=60
OLIVIA_STREAM_IDLE_TIMEOUT_S=0
OLIVIA_VISIBLE_PREFIX_MAX=256
# -3 aligns quota rollover with Argentina if desired.
OLIVIA_QUOTA_UTC_OFFSET_H=0


# Optional burst coding worker (GitHub Actions). Disabled by default.
# The gateway never gets shell access: it only dispatches the isolated workflow.
OLIVIA_CODING_WORKER_ENABLED=0
OLIVIA_CODING_REPO=simondalmasso/0liviA
OLIVIA_CODING_WORKFLOW=coding-agent.yml
# Fine-grained token / GitHub App token with only the permissions needed to dispatch/read Actions.
# OLIVIA_GITHUB_TOKEN=
# The coding-agent workflow separately expects repository secret NVIDIA_API_KEY.


# Optional live web search. Disabled by default.
# IMPORTANT: Cloudflare Web Search is billable unless the configured BYOK provider route
# itself has a separately verified hard-free boundary. Never use AI Gateway credits here.
OLIVIA_WEB_SEARCH_ENABLED=0
OLIVIA_WEB_SEARCH_ZERO_COST_VERIFIED=0
OLIVIA_CF_WEB_SEARCH_PROVIDER=exa
OLIVIA_CF_AI_GATEWAY_ID=default
# Required only when enabling a verified-free BYOK route:
# OLIVIA_CF_ACCOUNT_ID=
# OLIVIA_CF_API_TOKEN=
# OLIVIA_CF_WEB_SEARCH_BYOK_ALIAS=


# Optional JS browser burst worker. Disabled by default.
# Browser text/screenshots are returned as Actions artifacts, so the worker MUST use
# a dedicated private GitHub repository. The public 0liviA repo is intentionally invalid.
OLIVIA_BROWSER_WORKER_ENABLED=0
OLIVIA_BROWSER_REPO=owner/private-browser
OLIVIA_BROWSER_WORKFLOW=browser-agent.yml
# Under OLIVIA_HARD_ZERO_COST=1, enable only after GitHub Actions usage is verified
# to have a hard no-overage boundary for this repository/account.
OLIVIA_BROWSER_ZERO_COST_VERIFIED=0


# Optional official "Sign in with ChatGPT" plan lane (Plus/Pro eligible accounts).
# Tokens live only in the protected server-side profile file; never paste them into this env/UI.
# Enable only after the owner has verified that app credit use cannot create overage
# (for example: ChatGPT app credit use remains OFF and/or this app's usage limit is below 100%).
# The profile itself is created by the one-time OAuth onboarding helper, not by hand.
# Example provider entry:
# {"name":"chatgpt-plan","kind":"chatgpt_plan","model":"gpt-6-astra","profile_path":"/var/lib/0livia/private/chatgpt-plan.json","priority":1,"daily_limit":0,"cost_mode":"plan_included","no_credit_overage_verified":true}


# Provider catalog entries may optionally declare:
# "capabilities":["chat","research","vision","code","review"]
# Omitted capabilities default to ["chat"] for backwards compatibility.
# Keep unverified/paid routes disabled under OLIVIA_HARD_ZERO_COST=1.


# Muse Glimmer local challenger (disabled example; requires a separate capable host).
# Meta's official Q4_K_M GGUF is ~17 GB; DO NOT point Oracle A1 12 GB at it.
# Serve it with llama.cpp/vLLM on suitable self-owned hardware, then add this entry to
# OLIVIA_PROVIDERS_JSON only after latency/quality/stability benchmarks pass:
# {"name":"muse-glimmer-local","kind":"openai_compatible","base_url":"http://127.0.0.1:18080/v1","model":"Muse-Glimmer-30B","api_key_env":"","priority":20,"daily_limit":0,"cost_mode":"local","capabilities":["chat","research","vision","code","review"]}
